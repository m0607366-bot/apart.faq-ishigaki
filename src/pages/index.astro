---
// トップページ：WordPress と同じく、固定ページ「はじめに」（site.ts の introPage）の文章 → 新着記事の一覧
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Layout from "../diver/Layout.astro";
import HomeList from "../diver/HomeList.astro";
import { ptComponents } from "../diver/pt";
import { SITE } from "../diver/site";

// WordPress形式の検索URL（/?s=…）を新しい検索ページへ
const wpSearch = Astro.url.searchParams.get("s");
if (wpSearch !== null) return Astro.redirect(`/search?q=${encodeURIComponent(wpSearch)}`, 301);

const introSlug = (SITE as any).introPage as string | undefined;
const { entry: intro, cacheHint } = introSlug ? await getEmDashEntry("pages", introSlug) : { entry: null, cacheHint: undefined };
if (intro && Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---

<Layout title={SITE.title} canonical={`${Astro.url.origin}/`}>
	{
		intro && (
			<article class="d-card d-page">
				<h1 class="d-article__title" {...intro.edit.title}>{intro.data.title}</h1>
				<div class="d-content" {...intro.edit.content}>
					<PortableText value={intro.data.content} components={ptComponents} />
				</div>
			</article>
		)
	}
	<HomeList page={1} />
</Layout>
