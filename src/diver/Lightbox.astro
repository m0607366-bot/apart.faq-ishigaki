---
// 本文の写真をクリックすると、画面いっぱいに拡大表示する（ライトボックス）
// ← → キー・スワイプで同じ記事の前後の写真へ、Esc・背景クリックで閉じる
---

<div class="lb" id="lb" hidden aria-hidden="true" role="dialog" aria-label="写真の拡大表示">
	<button type="button" class="lb__close" aria-label="閉じる">×</button>
	<button type="button" class="lb__nav lb__prev" aria-label="前の写真">‹</button>
	<figure class="lb__figure">
		<img class="lb__img" alt="" />
		<figcaption class="lb__caption"></figcaption>
	</figure>
	<button type="button" class="lb__nav lb__next" aria-label="次の写真">›</button>
	<div class="lb__count"></div>
</div>

<script is:inline>
	(function () {
		const box = document.getElementById("lb");
		if (!box) return;
		const imgEl = box.querySelector(".lb__img");
		const cap = box.querySelector(".lb__caption");
		const count = box.querySelector(".lb__count");
		let list = [];
		let idx = 0;

		// srcset の中で一番大きい画像を使う
		function fullSrc(img) {
			const set = img.getAttribute("srcset");
			if (set) {
				let best = null, bestW = 0;
				set.split(",").forEach((part) => {
					const [url, w] = part.trim().split(/\s+/);
					const n = parseInt(w, 10) || 0;
					if (url && n >= bestW) { best = url; bestW = n; }
				});
				if (best) return best;
			}
			return img.currentSrc || img.src;
		}

		function targets() {
			return [...document.querySelectorAll(".d-content img")].filter(
				(img) => !img.closest(".d-linkcard") && !img.closest("a[href]:not([href$='.jpg']):not([href$='.jpeg']):not([href$='.png']):not([href$='.webp'])") && img.naturalWidth !== 1,
			);
		}

		function show(i) {
			idx = (i + list.length) % list.length;
			const img = list[idx];
			imgEl.src = fullSrc(img);
			imgEl.alt = img.alt || "";
			const fig = img.closest("figure");
			const c = fig && fig.querySelector("figcaption");
			cap.textContent = (c && c.textContent.trim()) || img.alt || "";
			count.textContent = list.length > 1 ? idx + 1 + " / " + list.length : "";
			box.classList.toggle("lb--single", list.length < 2);
			// 次の写真を先読み
			if (list.length > 1) new Image().src = fullSrc(list[(idx + 1) % list.length]);
		}

		function open(img) {
			list = targets();
			const i = list.indexOf(img);
			if (i < 0) return;
			show(i);
			box.hidden = false;
			box.setAttribute("aria-hidden", "false");
			document.documentElement.classList.add("lb-open");
		}

		function close() {
			box.hidden = true;
			box.setAttribute("aria-hidden", "true");
			document.documentElement.classList.remove("lb-open");
			imgEl.removeAttribute("src");
		}

		document.addEventListener("click", (e) => {
			const img = e.target.closest && e.target.closest(".d-content img");
			if (img && !box.contains(img) && targets().includes(img)) {
				e.preventDefault();
				open(img);
			}
		});
		box.querySelector(".lb__close").onclick = close;
		box.querySelector(".lb__prev").onclick = (e) => { e.stopPropagation(); show(idx - 1); };
		box.querySelector(".lb__next").onclick = (e) => { e.stopPropagation(); show(idx + 1); };
		box.addEventListener("click", (e) => { if (e.target === box || e.target.classList.contains("lb__figure")) close(); });
		document.addEventListener("keydown", (e) => {
			if (box.hidden) return;
			if (e.key === "Escape") close();
			else if (e.key === "ArrowLeft") show(idx - 1);
			else if (e.key === "ArrowRight") show(idx + 1);
		});
		// スマホのスワイプ
		let sx = null, sy = null;
		box.addEventListener("touchstart", (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
		box.addEventListener("touchend", (e) => {
			if (sx === null) return;
			const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
			if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(idx + (dx < 0 ? 1 : -1));
			else if (dy > 80 && Math.abs(dy) > Math.abs(dx)) close();
			sx = sy = null;
		});
	})();
</script>

<style is:global>
	.d-content img { cursor: zoom-in; }
	.d-content .d-linkcard img, .d-content .d-youtube img { cursor: pointer; }
	html.lb-open { overflow: hidden; }
	.lb { position: fixed; inset: 0; z-index: 1000; background: rgba(0, 0, 0, 0.88); display: flex; align-items: center; justify-content: center; animation: lb-in 0.15s ease-out; }
	.lb[hidden] { display: none; }
	@keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
	.lb__figure { margin: 0; max-width: 94vw; max-height: 90vh; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; }
	.lb__img { max-width: 94vw; max-height: 84vh; object-fit: contain; box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5); background: #222; cursor: default; }
	.lb__caption { color: #eee; font-size: 0.85rem; margin-top: 10px; text-align: center; }
	.lb__close { position: absolute; top: 10px; right: 14px; width: 44px; height: 44px; border: 0; background: none; color: #fff; font-size: 2rem; line-height: 1; cursor: pointer; opacity: 0.85; }
	.lb__nav { position: absolute; top: 50%; transform: translateY(-50%); width: 52px; height: 80px; border: 0; background: rgba(255, 255, 255, 0.08); color: #fff; font-size: 2.6rem; line-height: 1; cursor: pointer; border-radius: 4px; }
	.lb__nav:hover, .lb__close:hover { background: rgba(255, 255, 255, 0.18); opacity: 1; }
	.lb__prev { left: 10px; }
	.lb__next { right: 10px; }
	.lb--single .lb__nav { display: none; }
	.lb__count { position: absolute; bottom: 12px; left: 0; right: 0; text-align: center; color: #bbb; font-size: 0.8rem; }
	@media (max-width: 767px) {
		.lb__nav { width: 40px; height: 60px; font-size: 2rem; background: rgba(0, 0, 0, 0.25); }
		.lb__img { max-width: 100vw; max-height: 80vh; }
	}
</style>
